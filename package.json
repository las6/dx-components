{
  "name": "dx-components",
  "version": "1.2.2",
  "description": "Copy-paste-ready DX components for Vite + TanStack",
  "type": "module",
  "exports": {
    "./components/ErrorComponent": "./components/ErrorComponent.tsx",
    "./components/NotFoundComponent": "./components/NotFoundComponent.tsx",
    "./components/PendingComponent": "./components/PendingComponent.tsx",
    "./components/ErrorPage": "./components/ErrorPage.tsx"
  },
  "files": [
    "components/"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "dev": "pnpm --dir dev dev",
    "docs:dev": "astro dev",
    "docs:build": "astro build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-version": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "preversion": "node scripts/sync-version.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/las6/dx-components"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/react": "^7.1.0",
    "@astrojs/starlight": "^0.42.6",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "centry-client": "^1.4.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.2"
  }
